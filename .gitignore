# --- сборка и кэш Urho3D ---
build/
build*/
.cache/
dist/
release/
bin/MyShooter
*.o
*.obj
*.a
*.so
*.so.*

# --- логи и артефакты запуска ---
*.log
Urho3D.log
run_log.txt
core
core.*

# --- бэкапы и «сломанные» копии исходников ---
*.bak
*.bak[0-9]*
*.broken.*
*.orig
*.rej
*~

# --- патчи/бандлы: это артефакты переноса, а не исходники ---
*.bundle
*.patch

# --- кэш Python и генерируемые ассеты ---
__pycache__/
*.pyc
