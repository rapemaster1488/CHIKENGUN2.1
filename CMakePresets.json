{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "tests",
      "displayName": "Headless core tests",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_GAME": "OFF",
        "TEX_SIZE": "512"
      }
    },
    {
      "name": "desktop",
      "displayName": "Urho3D desktop client",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_GAME": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "jobs": 2
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
